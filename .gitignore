*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Environments and secrets
.venv/
venv/
.env
.env.*

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Streamlit local secrets
.streamlit/secrets.toml
